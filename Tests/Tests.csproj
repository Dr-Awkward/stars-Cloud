  Headless net10.0 test project (design Section A.6). Was net4.8 with a
  packages.config NUnit 3.12 reference and a dependency on the WinForms Nova GUI;
  now SDK-style with PackageReference NUnit 3.14 + adapter + test SDK, referencing
  only the headless engine (Common + ServerState). GUI-coupled tests are excluded
  until the client is ported.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nova.Tests</AssemblyName>
    <RootNamespace>Nova.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
  </ItemGroup>

  <!-- The component/tech database, copied beside the test assembly so the
       headless component loader can find it without a dialog (design A.2). -->
  <ItemGroup>
    <None Include="..\components.xml" CopyToOutputDirectory="PreserveNewest" Link="components.xml" />
  </ItemGroup>

  <!-- GUI-coupled tests: depend on the WinForms Nova client (Nova.WinForms.Console).
       Re-enable when the desktop client is ported (deferred past M2). -->
  <ItemGroup>
    <Compile Remove="UnitTests\BattleEngineTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\ServerState\Server.csproj" />
  </ItemGroup>

</Project>
