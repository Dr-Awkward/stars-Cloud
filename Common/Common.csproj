  Headless net10.0 port of the shared engine contract (design Section A.0/A.1).
  Drops the x86, USE_COMMAND_ORDERS, ClickOnce, and pre-build lock hacks; drops
  the System.Drawing / System.Windows.Forms / SOAP-serialization framework
  references. The WinForms and live-Bitmap files are excluded here and move to a
  client presentation assembly when the desktop GUI is ported (deferred past M2).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nova.Common</AssemblyName>
    <RootNamespace>Nova.Common</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Hand-written assembly attributes live in Properties/AssemblyInfo.cs and
         the shared ..\VersionInfo.cs; do not let the SDK generate its own. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The legacy .resx files embed bitmaps (System.Drawing at build time) and
         are client-only; keep every .resx out of the headless build. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The shared version stamp sits at the repository root, outside this project
       directory, so it is not caught by the default glob. -->
  <ItemGroup>
    <Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
  </ItemGroup>

  <!-- Client-only files: WinForms forms, designer-generated settings/resources,
       and the dead BinaryFormatter serializer (design A.2/A.3, M0.md steps 3-6).
       They stay on disk for the eventual GUI port but are not compiled headless. -->
  <ItemGroup>
    <Compile Remove="ComboBoxItem.cs" />
    <Compile Remove="ProgressDialog.cs" />
    <Compile Remove="ProgressDialog.Designer.cs" />
    <Compile Remove="Serializer.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="Properties\Resources.Designer.cs" />
  </ItemGroup>

  <!-- Stale duplicates that sit on disk but were never in the curated legacy
       build (the real types live under Files\ or ServerState). The default glob
       would compile them and collide; the legacy explicit list excluded them. -->
  <ItemGroup>
    <Compile Remove="Scores.cs" />
    <Compile Remove="DataStructures\GameSettings.cs" />
    <Compile Remove="DataStructures\Intel.cs" />
    <Compile Remove="DataStructures\Orders.cs" />
    <Compile Remove="DataStructures\ProductionItem.cs" />
  </ItemGroup>

</Project>
