<!--
  Galaxies, a cloud port of Stars! Nova.
  Copyright (C) 2026 Farehard. GPL v2; see LICENSE.txt.

  galaxies-api (design Sections C, D, E): the public Cloud Run gateway. Verifies
  Google identity, mints first-party session JWTs, runs the game lifecycle and
  lobby, accepts and validates orders, serves per-empire intel with fog-of-war
  authorization, tracks submissions, and owns the turn clock (deadlines, the
  exactly-once generation guard, host controls). References the headless engine
  (Common + ServerState), the shared control plane, and the Google SDKs.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Galaxies.Api</AssemblyName>
    <RootNamespace>Galaxies.Api</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\ServerState\Server.csproj" />
    <ProjectReference Include="..\ControlPlane\Galaxies.ControlPlane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore" Version="3.9.0" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.10.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.72.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

</Project>
